#!/usr/bin/env bash
# tjob: the CLI orchestrator's jobs, from a shell (the orchestrating session and each job's agent).
#   tjob new "<title>" [--repo PATH] [--backend auto|claude|codex|glm|agy|zcode] [--model ID] [--base BRANCH] [--kind feature|bugfix] [--prompt TEXT]   (else the prompt is read from stdin)
#                           --kind: the branch family, feature/<slug>-<id> (default) or bugfix/<slug>-<id>
#                           --model: one the backend offers; GLM runs glm-5.3-flash unless asked for glm-5.3; with --backend auto, the model picks the backend
#   tjob ls                 every job: backend, state, what its session is doing, where it is in the CI/CD queue
#   tjob show <id>
#   tjob done <id>          the agent's code is complete and committed: it waits at review for the orchestrating session
#   tjob approve <id>       the orchestrating session (the hub) reviewed the branch: hand it to the CI/CD queue
#   tjob retry <id>         a blocked merge goes on from where it stopped
#   tjob cancel <id>        the person does not want the job anymore: frees its slot, leaves the CI/CD queue
#   tjob resume <id>        a cancelled or failed job takes a slot again
#   tjob rollback <id> <turn> [--discard-untracked]  reset the job's worktree files to how an earlier turn left them (per-turn
#                              checkpoint; refuses while the job runs, and when untracked files would be lost unless
#                              --discard-untracked moves them into .tribeira-rollback/<timestamp>/)
#   tjob cleanup [--dry-run]  sweep merged and cancelled jobs
#   tjob hub-wake [--test]  wake the orchestrating session (the hub) on job events
set -euo pipefail

marker="$HOME/.cloudcli/local-server.json"
url="${CLI_URL:-$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["url"])' "$marker" 2>/dev/null || echo http://127.0.0.1:8197)}"
token_file="${CLI_ORCHESTRATOR_TOKEN_FILE:-$HOME/.cloudcli/orchestrator.token}"
[ -r "$token_file" ] || { echo "tjob: no token at $token_file (is the CLI server running?)" >&2; exit 1; }

# The token goes to curl on stdin, never on the command line.
api() {
  local method=$1 path=$2 body=${3:-}
  { printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '\n' <"$token_file")"
    [ -n "$body" ] && printf 'header = "Content-Type: application/json"\n'
  } | curl -sS -X "$method" --config - ${body:+--data-binary "$body"} "$url/api/orchestrator$path"
}

render() {
  python3 -c '
import json, sys
body = json.load(sys.stdin)
if not body.get("success", False):
    sys.exit("tjob: " + str((body.get("error") or {}).get("message") if isinstance(body.get("error"), dict) else body.get("error") or body))
data = body["data"]
mode = sys.argv[1]
def line(j):
    doing = j.get("activity") or j["state"]
    merge = "" if j["merge_step"] == "none" else "  ci:" + j["merge_step"]
    err = ("  ! " + j["last_error"].splitlines()[0][:100]) if j.get("last_error") else ""
    fallback = "  (glm quota fallback)" if j.get("quotaFallback") else ""
    wait = j.get("limitWait")
    if wait:
        what = "usage limit" if wait["failureClass"] == "usage_limit" else "login needed"
        if wait.get("resumesAt"):
            import datetime
            at = datetime.datetime.fromisoformat(wait["resumesAt"].replace("Z", "+00:00")).astimezone()
            same_day = at.date() == datetime.datetime.now().astimezone().date()
            what += ", resumes " + at.strftime("%H:%M" if same_day else "%b %d %H:%M")
        elif wait.get("waitsForHub"):
            what += ", waiting for the hub"
        err = "  ! " + what
    model = (j.get("model") or "").split("/")[-1]
    return "%s  %-6s %-14s %-11s%-13s %s%s" % (j["id"], j.get("backend") or "-", model or "-", doing, merge, j["title"][:60], err + fallback)
if mode == "ls":
    loads, caps = data["loads"], data["caps"]
    print("  ".join("%s: %s/%s" % (b, loads.get(b, 0), caps.get(b, 0)) for b in ("claude", "codex", "glm", "agy", "zcode")))
    for backend, status in data.get("backendStatus", {}).items():
        if status: print("%s: quota-exhausted until %s" % (backend, status))
    for j in data["jobs"]: print(line(j))
else:
    j = data["job"]
    print(line(j))
    if mode == "show":
        for k in ("repo_path", "base_branch", "branch", "worktree_path", "session_id", "model", "pushed_sha", "checkLogPath", "last_error"):
            if j.get(k): print("  %s: %s" % (k, j[k]))
        u = j.get("usage")
        if u:
            cost = u.get("notionalCostUsd")
            cost_str = ("$%0.4f notional USD" % cost) if (cost is not None and u.get("costSource") != "unpriced") else "unpriced"
            print("  tokens: %s in, %s out, %s cache (notional: %s)" % (
                u.get("inputTokens", 0),
                u.get("outputTokens", 0),
                u.get("cacheTokens", 0),
                cost_str
            ))
        def took(ms):
            if ms is None: return ""
            m, sec = divmod(int(ms) // 1000, 60)
            return "%dm%02ds" % (m, sec) if m else "%ds" % sec
        steps = j.get("mergeSteps") or []
        if steps: print("  steps: " + ", ".join(("%s %s" % (e["step"], took(e.get("durationMs")))).strip() for e in steps))
' "$1"
}

json_body() { python3 -c 'import json,sys; print(json.dumps(dict(zip(sys.argv[1::2], sys.argv[2::2]))))' "$@"; }

cmd=${1:-ls}; shift || true
case "$cmd" in
  new)
    title=${1:?usage: tjob new "<title>" [--repo PATH] [--backend B] [--model ID] [--base BRANCH] [--kind feature|bugfix] [--prompt TEXT]}; shift
    repo="" backend=auto model="" base="" kind="" prompt=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --repo) repo=$2; shift 2 ;;
        --backend) backend=$2; shift 2 ;;
        --model) model=$2; shift 2 ;;
        --base) base=$2; shift 2 ;;
        --kind) kind=$2; shift 2 ;;
        --prompt) prompt=$2; shift 2 ;;
        *) echo "tjob: unknown option $1" >&2; exit 2 ;;
      esac
    done
    # The main checkout, also when run from inside a job's worktree.
    [ -n "$repo" ] || repo=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
    [ -n "$prompt" ] || prompt=$(cat)
    args=(title "$title" prompt "$prompt" repo "$(realpath "$repo")" backend "$backend")
    [ -n "$model" ] && args+=(model "$model")
    [ -n "$base" ] && args+=(base "$base")
    [ -n "$kind" ] && args+=(kind "$kind")
    api POST "" "$(json_body "${args[@]}")" | render new ;;
  ls) api GET "" | render ls ;;
  show) api GET "/${1:?id}" | render show ;;
  done|approve|retry|resume|cancel) api POST "/${1:?id}/$cmd" '{}' | render "$cmd" ;;
  rollback)
    usage="usage: tjob rollback <id> <turn> [--discard-untracked]"
    id=${1:?$usage}; shift
    turn=${1:?$usage}; shift
    case $turn in ''|*[!0-9]*) echo "$usage" >&2; exit 2 ;; esac
    discard=false
    if [ "${1:-}" = "--discard-untracked" ]; then discard=true; shift; fi
    [ $# -eq 0 ] || { echo "$usage" >&2; exit 2; }
    api POST "/$id/rollback" "{\"turn\":$turn,\"discardUntracked\":$discard}" | python3 -c '
import json, sys
body = json.load(sys.stdin)
if not body.get("success", False):
    sys.exit("tjob: " + str((body.get("error") or {}).get("message") if isinstance(body.get("error"), dict) else body.get("error") or body))
r = body["data"]["rollback"]
where = "recreated worktree, " if r.get("recreatedWorktree") else ""
print("rolled back %s to turn %s: %scommit %s" % (r["jobId"], r["turn"], where, r["commitSha"][:8]))
if r.get("movedUntrackedTo"):
    print("moved %d untracked file(s) into %s" % (len(r.get("movedUntracked") or []), r["movedUntrackedTo"]))
' ;;
  cleanup)
    dry=false
    if [ "${1:-}" = "--dry-run" ]; then dry=true; shift; fi
    [ $# -eq 0 ] || { echo "usage: tjob cleanup [--dry-run]" >&2; exit 2; }
    api POST "/cleanup" "{\"dryRun\":$dry}" | python3 -c '
import json, sys
body = json.load(sys.stdin)
if not body.get("success", False): sys.exit("tjob: " + str(body.get("error")))
for item in body["data"]["results"]: print(item["id"] + "  " + item["status"])
' ;;
  hub-wake)
    test_arg="false"
    if [ "${1:-}" = "--test" ]; then test_arg="true"; fi
    api POST "/hub-wake" "$(json_body test "$test_arg")" | python3 -c '
import json, sys
body = json.load(sys.stdin)
if not body.get("success", False):
    sys.exit("tjob: " + str((body.get("error") or {}).get("message") if isinstance(body.get("error"), dict) else body.get("error") or body))
print(body.get("data", {}).get("message", "wake sent"))
' ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
